rules_version = '2';

/**
 * KEY2RAJ Firestore rules.
 *
 * The website reads and writes through the Firebase Admin SDK on the
 * server, which bypasses these rules. So these rules exist to control
 * what a browser could do if someone tried to reach the database
 * directly with the public API key. The answer is: read published
 * properties, and nothing else.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /properties/{propertyId} {
      // Anyone may read a published property. Drafts stay hidden.
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Bookings and enquiries are written by the server only. A visitor
    // must never be able to read other people's contact details.
    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if false; // roles are granted by the make-admin script
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
